{
  "name": "gameverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:security",
    "test:unit": "npx tsx --test tests/unit/validation.test.ts tests/unit/auth-flows.test.ts tests/unit/games.test.ts tests/unit/teen-patti.test.ts tests/unit/multiplayer-games.test.ts",
    "test:security": "npx tsx --test tests/security/security-audit.test.ts",
    "test:e2e": "npx playwright test",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@types/three": "^0.186.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
